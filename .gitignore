# VaultPass Android - .gitignore
# Built outputs, caches, keys, and user vault files

# ==========================================
# 1. Android & Gradle Build Outputs
# ==========================================
*.apk
*.ap_
*.aab
*.dex
*.class
/build
build/
/captures
.externalNativeBuild
.cxx

# ==========================================
# 2. Local Vault Data & Backups (CRITICAL)
# ==========================================
*.db
*.db-journal
*.db-wal
*.db-shm
*.vpex
*.vpb
# Also numbered copies such as "vaultpass_export (1).csv".
vaultpass_backup*
vaultpass_export*

# ==========================================
# 3. Gradle & SDK Configuration
# ==========================================
.gradle
/.gradle/
.kotlin
/.kotlin/
local.properties
/local.properties

# ==========================================
# 4. IDE & Editor Files
# ==========================================
*.iml
/.idea/
.idea/
.vscode/
/.vscode/

# ==========================================
# 5. Keystores, Signing Keys & Secrets
# ==========================================
*.jks
*.keystore
debug.keystore
*.key
*.pem
*.p12
*.pfx
*.pepk
key.properties
keystore.properties
signing.properties
.env
.env.*
# Template with placeholder values only; meant to be committed.
!.env.example
secrets.json
service-account*.json
google-services.json

# ==========================================
# 6. OS & Temporary Files
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
*.log
*~
*.swp
*.tmp
*.bak
# Heap and crash dumps can contain decrypted passwords.
*.hprof
hs_err_pid*
replay_pid*

# ==========================================
# 7. Internal Documentation & Workflows
# ==========================================
PROJECT_MEMORY.md
GEMINI_SYSTEM_PROMPT.md
/stitch_vaultpass_premium_android_ui
ARCHITECTURE.md
FUTURE_IMPLEMENTATIONS.md