{
  "description": "Two-step sign-in, first page: identifier field plus a hidden password field. Hand-made from what Chrome sends (Chromium FormData.fillViewStructure): no class name, input type or view id; HTML attributes, placeholder as hint, autocomplete as autofill hints.",
  "packageName": "com.android.chrome",
  "windows": [
    {
      "id": "root",
      "className": "com.android.internal.policy.DecorView",
      "width": 1080,
      "height": 2400,
      "children": [
        {
          "className": "android.widget.LinearLayout",
          "width": 1080,
          "height": 2400,
          "children": [
            {
              "id": "form",
              "className": "android.widget.FrameLayout",
              "width": 1080,
              "height": 2000,
              "webDomain": "accounts.google.com",
              "webScheme": "https",
              "htmlTag": "form",
              "htmlAttributes": {
                "name": ""
              },
              "children": [
                {
                  "id": "identifier",
                  "autofillType": 1,
                  "width": 900,
                  "height": 140,
                  "htmlTag": "input",
                  "htmlAttributes": {
                    "name": "identifier",
                    "type": "email",
                    "label": "Email or phone",
                    "ua-autofill-hints": "",
                    "id": "identifierId",
                    "crowdsourcing-autofill-hints": "",
                    "computed-autofill-hints": ""
                  },
                  "hints": [
                    "username",
                    "webauthn"
                  ],
                  "focused": true
                },
                {
                  "id": "hiddenPassword",
                  "autofillType": 1,
                  "width": 900,
                  "height": 140,
                  "htmlTag": "input",
                  "htmlAttributes": {
                    "name": "hiddenPassword",
                    "type": "password",
                    "label": "",
                    "ua-autofill-hints": "",
                    "id": "",
                    "crowdsourcing-autofill-hints": "",
                    "computed-autofill-hints": ""
                  },
                  "visibility": 4
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "expected": {
    "username": "identifier",
    "webDomain": "accounts.google.com",
    "formKind": "LOGIN",
    "focused": "identifier"
  }
}
