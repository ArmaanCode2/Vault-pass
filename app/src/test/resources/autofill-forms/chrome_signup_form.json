{
  "description": "Sign-up form: the saved password never goes into the confirm box. Hand-made from what Chrome sends (Chromium FormData.fillViewStructure): no class name, input type or view id; HTML attributes, placeholder as hint, autocomplete as autofill hints.",
  "packageName": "com.android.chrome",
  "windows": [
    {
      "id": "root",
      "className": "com.android.internal.policy.DecorView",
      "width": 1080,
      "height": 2400,
      "children": [
        {
          "className": "android.widget.LinearLayout",
          "width": 1080,
          "height": 2400,
          "children": [
            {
              "id": "form",
              "className": "android.widget.FrameLayout",
              "width": 1080,
              "height": 2000,
              "webDomain": "www.example-shop.com",
              "webScheme": "https",
              "htmlTag": "form",
              "htmlAttributes": {
                "name": ""
              },
              "children": [
                {
                  "id": "email",
                  "autofillType": 1,
                  "width": 900,
                  "height": 140,
                  "htmlTag": "input",
                  "htmlAttributes": {
                    "name": "email",
                    "type": "email",
                    "label": "",
                    "ua-autofill-hints": "",
                    "id": "",
                    "crowdsourcing-autofill-hints": "",
                    "computed-autofill-hints": ""
                  },
                  "hints": [
                    "email"
                  ],
                  "focused": true
                },
                {
                  "id": "newPass",
                  "autofillType": 1,
                  "width": 900,
                  "height": 140,
                  "htmlTag": "input",
                  "htmlAttributes": {
                    "name": "password",
                    "type": "password",
                    "label": "",
                    "ua-autofill-hints": "",
                    "id": "",
                    "crowdsourcing-autofill-hints": "",
                    "computed-autofill-hints": ""
                  },
                  "hints": [
                    "new-password"
                  ]
                },
                {
                  "id": "confirm",
                  "autofillType": 1,
                  "width": 900,
                  "height": 140,
                  "htmlTag": "input",
                  "htmlAttributes": {
                    "name": "password_confirm",
                    "type": "password",
                    "label": "",
                    "ua-autofill-hints": "",
                    "id": "",
                    "crowdsourcing-autofill-hints": "",
                    "computed-autofill-hints": ""
                  },
                  "hints": [
                    "new-password"
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "expected": {
    "username": "email",
    "password": "newPass",
    "webDomain": "www.example-shop.com",
    "formKind": "SIGNUP",
    "focused": "email"
  }
