{
  "description": "Change-password form with the new-password box focused: the saved password goes into the current-password box only. Hand-made from what Chrome sends (Chromium FormData.fillViewStructure): no class name, input type or view id; HTML attributes, placeholder as hint, autocomplete as autofill hints.",
  "packageName": "com.android.chrome",
  "windows": [
    {
      "id": "root",
      "className": "com.android.internal.policy.DecorView",
      "width": 1080,
      "height": 2400,
      "children": [
        {
          "className": "android.widget.LinearLayout",
          "width": 1080,
          "height": 2400,
          "children": [
            {
              "id": "form",
              "className": "android.widget.FrameLayout",
              "width": 1080,
              "height": 2000,
              "webDomain": "accounts.example.com",
              "webScheme": "https",
              "htmlTag": "form",
              "htmlAttributes": {
                "name": ""
              },
              "children": [
                {
                  "id": "current",
                  "autofillType": 1,
                  "width": 900,
                  "height": 140,
                  "htmlTag": "input",
                  "htmlAttributes": {
                    "name": "old_password",
                    "type": "password",
                    "label": "Current password",
                    "ua-autofill-hints": "",
                    "id": "",
                    "crowdsourcing-autofill-hints": "",
                    "computed-autofill-hints": ""
                  }
                },
                {
                  "id": "new",
                  "autofillType": 1,
                  "width": 900,
                  "height": 140,
                  "htmlTag": "input",
                  "htmlAttributes": {
                    "name": "new_password",
                    "type": "password",
                    "label": "New password",
                    "ua-autofill-hints": "",
                    "id": "",
                    "crowdsourcing-autofill-hints": "",
                    "computed-autofill-hints": "NEW_PASSWORD"
                  },
                  "focused": true
                },
                {
                  "id": "confirm",
                  "autofillType": 1,
                  "width": 900,
                  "height": 140,
                  "htmlTag": "input",
                  "htmlAttributes": {
                    "name": "new_password2",
                    "type": "password",
                    "label": "Confirm new password",
                    "ua-autofill-hints": "",
                    "id": "",
                    "crowdsourcing-autofill-hints": "",
                    "computed-autofill-hints": "CONFIRMATION_PASSWORD"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "expected": {
    "password": "current",
    "webDomain": "accounts.example.com",
    "formKind": "CHANGE_PASSWORD",
    "focused": "new"
  }
}
